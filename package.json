{
  "name": "what-ui-guide",
  "version": "0.1.0",
  "license": "0BSD",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "npm run build && node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run typecheck && node scripts/run-unit-tests.mjs && npm run build && node scripts/run-production-tests.mjs && playwright test",
    "test:browser": "npm run build && playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern outputs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.0",
    "@cloudflare/workers-types": "5.20260710.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "brace-expansion": "file:./vendor/brace-expansion-compat",
    "brace-expansion-modern": "npm:brace-expansion@5.0.8",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.111.0"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "$brace-expansion"
    },
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  },
  "type": "module"
}
