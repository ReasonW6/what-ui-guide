# Server-managed OpenAI access. Leave blank to require BYOK in the UI.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-sol.
OPENAI_MODEL=gpt-5.6-sol

# Exact public hostnames that may use browser snapshots. Comma-separated;
# wildcards are intentionally unsupported.
BROWSER_ALLOWED_HOSTS=yoursite.com,www.yoursite.com

# Exact public HTTPS hostnames that the Worker may proxy for custom providers.
# Leave blank to keep the custom-provider Worker proxy disabled.
CUSTOM_PROVIDER_ALLOWED_HOSTS=

# Optional Cloudflare Browser Rendering REST credentials. Prefer a Worker
# BROWSER binding in production when the hosting environment supports it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
